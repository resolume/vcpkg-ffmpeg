When the linker is the compiler driver (GNU-style clang targeting
windows-msvc, e.g. cross builds from Linux), the MSVC-style shared-lib
flags must be forwarded with -Wl, or the driver rejects them (#25367).
--- a/configure
+++ b/configure
@@ -5890,7 +5890,11 @@
         SLIB_INSTALL_LINKS=
         SLIB_INSTALL_EXTRA_SHLIB='$(SLIBNAME:$(SLIBSUF)=.lib)'
         SLIB_INSTALL_EXTRA_LIB='$(SLIBNAME_WITH_MAJOR:$(SLIBSUF)=.def)'
-        SHFLAGS='-dll -def:$$(@:$(SLIBSUF)=.def) -implib:$(SUBDIR)$(SLIBNAME:$(SLIBSUF)=.lib)'
+        if test "$ld" = "$cc"; then
+            SHFLAGS='-Wl,-dll -Wl,-def:$$(@:$(SLIBSUF)=.def) -Wl,-implib:$(SUBDIR)$(SLIBNAME:$(SLIBSUF)=.lib)'
+        else
+            SHFLAGS='-dll -def:$$(@:$(SLIBSUF)=.def) -implib:$(SUBDIR)$(SLIBNAME:$(SLIBSUF)=.lib)'
+        fi
         enabled x86_64 && objformat="win64" || objformat="win32"
         ranlib=:
         enable dos_paths
--- a/configure
+++ b/configure
@@ -5871,7 +5871,11 @@
 #        if enabled shared; then
             # Link to the import library instead of the normal static library
             # for shared libs.
-            LD_LIB='%.lib'
+            if test "$ld" = "$cc"; then
+                LD_LIB='-l%'
+            else
+                LD_LIB='%.lib'
+            fi
             # Cannot build both shared and static libs with MSVC or icl.
 #            disable static
 #        fi
